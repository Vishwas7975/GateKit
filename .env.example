# ─── App Settings ────────────────────────────────────────────────────────
APP_NAME=Gatekit
# Public URL this API is served from (no trailing slash)
APP_URL=http://localhost:8000
# Only set this if the app lives in a subfolder, e.g. "gatekit" for
# http://localhost/gatekit — leave empty if it's served from the domain root.
APP_BASE_PATH=
# URL of the frontend app that consumes this API (used for CORS and the
# Google OAuth redirect after login)
FRONTEND_URL=http://localhost:5173

# ─── Database ────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gatekit
DB_USER=your_db_user
DB_PASS=your_db_password

# ─── JWT ─────────────────────────────────────────────────────────────────
# Required. Generate a long random string, e.g.:
#   php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRY=3600
JWT_REFRESH_EXPIRY=604800

# ─── Google OAuth ────────────────────────────────────────────────────────
# From Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Must exactly match an Authorized redirect URI in the Google Cloud Console
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ─── Mail / SMTP (for the OTP password-reset email) ─────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
# "smtps" for port 465, "tls" for port 587
MAIL_ENCRYPTION=smtps
MAIL_USERNAME=your_smtp_username@example.com
# For Gmail: a 16-character App Password, not your normal account password
MAIL_PASSWORD=your_smtp_app_password
MAIL_FROM_ADDRESS=your_smtp_username@example.com
MAIL_FROM_NAME=Gatekit
